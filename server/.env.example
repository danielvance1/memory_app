# Copy this file to .env for local development (.env is git-ignored).
# It matches the database started by docker-compose.dev.yml at the repo root.
DATABASE_URL=postgres://memodeum:devpassword@localhost:5432/memodeum
PORT=3000

# Optional settings (the values shown are the defaults):
# MAX_USERS=500                    hard cap on total accounts
# SESSION_DAYS=30                  how long a login lasts
# SIGNUPS_PER_HOUR_PER_IP=5        signup attempts allowed per IP address per hour
# FAILED_LOGINS_PER_IP=10          failed logins allowed per IP address per 15 minutes
# FAILED_LOGINS_PER_ACCOUNT=20     failed logins allowed per account per 15 minutes

# Only for `npm test`: a SEPARATE throwaway database (the tests empty its tables).
# Create it once with:
#   docker compose -f ../docker-compose.dev.yml exec db createdb -U memodeum memodeum_test
# TEST_DATABASE_URL=postgres://memodeum:devpassword@localhost:5432/memodeum_test
